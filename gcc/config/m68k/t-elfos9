# The C library built for each calling convention: GCC's stack
# convention (the default) and the OS-9 convention (-mos9call), whose
# callers need a newlib built with it.  libgcc is the same in both: it
# keeps the stack convention (libgcc/config/m68k/t-elfos9).
MULTILIB_OPTIONS = mos9call
MULTILIB_DIRNAMES = os9call
